generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  restaurantId String
  status       OrderStatus @default(PENDING)
  totalAmount  Float
  deliveryAddress String
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  price      Float
  quantity   Int
  order      Order   @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
